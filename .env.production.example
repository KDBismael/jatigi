# Vercel > Settings > Environment Variables > Production. Redeploy after changes.
# Existing Supabase credentials for the production project:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

APP_BASE_URL=https://warko.app
# Enable only after configuring the LIVE webhook and setting billing_settings.mode=live.
MONERIZ_MODE=live
MONERIZ_LIVE_SECRET_KEY=
MONERIZ_LIVE_WEBHOOK_SECRET=

# Public catalog amounts in whole FCFA. Each empty value uses its default.
NEXT_PUBLIC_PRO_MONTHLY_PRICE=5000
NEXT_PUBLIC_PRO_YEARLY_PRICE=48000
NEXT_PUBLIC_BUSINESS_MONTHLY_PRICE=10000
NEXT_PUBLIC_BUSINESS_YEARLY_PRICE=96000

# Emails and scheduled processing (separate from checkout configuration):
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_REPLY_TO_EMAIL=ismaelkondombo1@gmail.com
NOTIFICATION_UNSUBSCRIBE_SECRET=
CRON_SECRET=
