NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# SaaS billing — keep mode consistent with public.billing_settings.mode.
APP_BASE_URL=http://localhost:3000
MONERIZ_MODE=test
MONERIZ_TEST_SECRET_KEY=
MONERIZ_LIVE_SECRET_KEY=
MONERIZ_TEST_WEBHOOK_SECRET=
MONERIZ_LIVE_WEBHOOK_SECRET=
# Email only. Configure a verified Resend sender before enabling the cron.
RESEND_API_KEY=
NOTIFICATION_REPLY_TO_EMAIL=
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_UNSUBSCRIBE_SECRET=
CRON_SECRET=

# Tarifs temporaires, uniquement avec MONERIZ_MODE=test.
# Renseigner les deux valeurs, puis redéployer. Retirer les deux et redéployer après test.
NEXT_PUBLIC_TEST_PRO_PRICE=
NEXT_PUBLIC_TEST_BUSINESS_PRICE=

# Prix permanents configurables en test ou live. Entiers FCFA, puis redéployer.
# Chaque valeur vide conserve son prix normal. Ne pas combiner avec les tarifs TEST.
NEXT_PUBLIC_PRO_MONTHLY_PRICE=
NEXT_PUBLIC_PRO_YEARLY_PRICE=
NEXT_PUBLIC_BUSINESS_MONTHLY_PRICE=
NEXT_PUBLIC_BUSINESS_YEARLY_PRICE=
